generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tarjetas de lealtad
model Card {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  email         String?
  birthday      String?
  stamps        Int       @default(0)
  max           Int       @default(8)
  cycles        Int       @default(0)
  status        String    @default("active")
  lastVisit     DateTime?
  latestMessage String? // Para notificaciones push
  source        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Tarjeta Digital Wallet
  cardType      String  @default("loyalty") // loyalty | annual | gold
  cardColor     String  @default("#8C9668") // Color hex del pase
  sessionsTotal Int     @default(0) // Sesiones prepagadas (Venus Constancia Anual)
  sessionsUsed  Int     @default(0) // Sesiones ya canjeadas
  walletPassUrl String? // URL Google Wallet Object

  // Membresía de Masajes (independiente de los sellos de lealtad)
  massageActive    Boolean @default(false) // Si tiene membresía de masajes activa
  massageStamps    Int     @default(0) // Sellos de masaje actuales
  massageMax       Int     @default(10) // Total de sesiones de masaje
  massageCycles    Int     @default(0) // Ciclos completados de masaje
  massageWalletUrl String? // URL Google Wallet para masajes

  // ===== MARKETING =====
  referralCode           String?  @unique @map("referral_code") // código de referido (ej. SAID10)
  referredByCardId       String?  @map("referred_by_card_id")  // quién la refirió
  referredBy             Card?    @relation("CardReferrals", fields: [referredByCardId], references: [id], onDelete: SetNull)
  referrals              Card[]   @relation("CardReferrals")
  referralStampsThisYear Int     @default(0) @map("referral_stamps_this_year") // tope 5/año
  birthdaySentYear        Int?    @map("birthday_sent_year")   // guard anti-doble envío cumpleaños
  isAmbassador            Boolean  @default(false) @map("is_ambassador")
  bestSendHour            Int?    @map("best_send_hour")        // hora top de actividad WhatsApp
  publicDisplayOk         Boolean  @default(false) @map("public_display_ok") // consentimiento UGC

  // Relaciones de referidos (programa Referral)
  referralsMade     Referral[] @relation("ReferralReferrer")
  referralsReceived Referral[] @relation("ReferralInvitee")

  // Relaciones
  appointments Appointment[]
  events       Event[]
  skinAnalyses SkinAnalysis[]
  touchpoints  Touchpoint[]
  challenges   Challenge[]

  @@map("cards")
}

// Servicios
model Service {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @default(60)
  category        String?
  discount        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("services")
}

// Citas
model Appointment {
  id              String   @id @default(cuid())
  clientName      String
  clientPhone     String
  serviceName     String
  date            String
  time            String
  startDateTime   DateTime
  endDateTime     DateTime
  durationMinutes Int      @default(60)
  status          String   @default("scheduled") // scheduled, confirmed, completed, cancelled, rescheduling
  location        String?

  // Pago
  totalPaid     Decimal? @db.Decimal(10, 2)
  paymentMethod String? // efectivo, tarjeta, transferencia
  discount      Decimal? @db.Decimal(10, 2)

  // Google Calendar
  googleCalendarEventId  String?
  googleCalendarEventId2 String?

  // WhatsApp reminders
  sendWhatsApp30h         Boolean   @default(false)
  sendWhatsApp24h         Boolean   @default(true)
  sendWhatsApp2h          Boolean   @default(true)
  sent30hAt               DateTime?
  sent24hAt               DateTime?
  sent2hAt                DateTime?
  sent48hAt               DateTime?
  sentConfirmationAlertAt DateTime?

  // Confirmación
  confirmedAt           DateTime?
  confirmedVia          String? // whatsapp, manual
  cancelledAt           DateTime?
  cancelledVia          String? // whatsapp, manual
  cancelReason          String?
  rescheduleRequestedAt DateTime?

  // Productos vendidos (JSON)
  productsSold Json?

  source       String?
  reviewSentAt DateTime? @map("review_sent_at")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relaciones
  cardId    String?
  card      Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  serviceId String?
  // Removemos la relación estricta con Service para permitir citas con servicios eliminados

  // Asignación manual a recepcionista/terapeuta. Si no se asigna queda null y
  // la cita solo va a los calendarios globales legacy (calendarOwner1/2).
  assignedAdminId String?
  assignedAdmin   Admin?  @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)

  // Atribución de marketing: admin que agendó la cita (para comisión).
  bookedById String? @map("booked_by_id")
  bookedBy   Admin?  @relation("AppointmentsBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)

  // Relación a comisión (1:1 opcional — solo citas agendadas por marketing)
  commission Commission?

  // Relación a lead (1:1 opcional — si la cita viene de un lead convertido)
  lead Lead?

  // Relación a touchpoint (atribución multi-touch)
  touchpoint Touchpoint?

  // Google Calendar mapping (OAuth2)
  calendarMappings GoogleCalendarMapping[]

  @@index([date, startDateTime])
  @@index([startDateTime])
  @@index([status, startDateTime])
  @@index([clientPhone, startDateTime])
  @@index([assignedAdminId])
  @@index([bookedById])
  @@map("appointments")
}

// Eventos (sellos, canjes)
model Event {
  id        String   @id @default(cuid())
  type      String // stamp, redeem
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  staffId   String?
  staffName String?
  note      String?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("events")
}

// Productos
model Product {
  id           String   @id @default(cuid())
  name         String
  category     String?
  presentation String?
  price        Decimal  @db.Decimal(10, 2)
  cost         Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  minStock     Int      @default(5)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("products")
}

// Gastos
model Expense {
  id          String   @id @default(cuid())
  date        String
  category    String // productos, renta, servicios, salarios, marketing, equipo, mantenimiento, transporte, otros
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

// Tarjetas de regalo
model GiftCard {
  id              String    @id @default(cuid())
  code            String    @unique
  amount          Decimal   @db.Decimal(10, 2)
  remainingAmount Decimal   @db.Decimal(10, 2)
  status          String    @default("pending") // pending, active, used, expired, redeemed
  purchaserName   String?
  purchaserPhone  String?
  recipientName   String?
  recipientPhone  String?
  message         String?
  expiresAt       DateTime?
  usedAt          DateTime?
  // Modelo basado en servicio (las gift cards de Venus son por servicio, no monto libre).
  // amount/remainingAmount se conservan por compatibilidad y reflejan servicePrice.
  serviceId       String?
  serviceName     String?
  servicePrice    Decimal?  @db.Decimal(10, 2)
  validityDays    Int?
  redeemedAt      DateTime?
  redeemedBy      String?
  appointmentId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("giftcards")
}

// Notificaciones
model Notification {
  id        String   @id @default(cuid())
  type      String // cumpleaños, premio, stock, giftcard, cita, alerta
  icon      String?
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?
  entityId  String? // ID de la entidad relacionada (cita, tarjeta, etc.)
  createdAt DateTime @default(now())

  @@map("notifications")
}

// Solicitudes de reserva (desde página pública)
model BookingRequest {
  id              String   @id @default(cuid())
  name            String?
  phone           String?
  serviceId       String?
  serviceName     String
  servicePrice    Decimal? @db.Decimal(10, 2)
  serviceDuration Int?
  date            String
  time            String
  clientName      String?
  clientPhone     String?
  clientEmail     String?
  clientBirthday  String?
  cardId          String?
  isNewClient     Boolean  @default(false)
  status          String   @default("pending") // pending, approved, rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("booking_requests")
}

// Configuración
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// Ventas (historial)
model Sale {
  id             String   @id @default(cuid())
  appointmentId  String?
  clientName     String?
  clientPhone    String?
  serviceName    String?
  serviceAmount  Decimal? @db.Decimal(10, 2)
  productsAmount Decimal? @db.Decimal(10, 2)
  products       Json?
  productsSold   Json?
  subtotal       Decimal  @db.Decimal(10, 2)
  discountType   String?
  discountValue  Decimal? @db.Decimal(10, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  discount       Decimal? @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  totalAmount    Decimal? @db.Decimal(10, 2)
  paymentMethod  String
  date           DateTime
  createdAt      DateTime @default(now())

  @@map("sales")
}

// Administradores
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  pass_hash String
  role      String   @default("admin")
  // Nombre legible para mostrar (dropdown asignación, badges en citas, email subject)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth multi-cuenta: cada admin puede conectar su propio Gmail/Calendar
  googleCalendar       AdminGoogleCalendar?
  // Citas que este admin atenderá (asignación manual al agendar)
  assignedAppointments Appointment[]
  // Citas que este admin agendó (atribución de marketing / comisión)
  bookedAppointments   Appointment[] @relation("AppointmentsBookedBy")
  // Leads asignados a este marketer
  leads                Lead[]
  // Comisiones generadas por este marketer
  commissions          Commission[]

  @@map("admins")
}

// Calendar OAuth por admin individual.
// Coexiste con GoogleCalendarConfig (singleton legacy) — no lo reemplaza.
// El singleton sigue manejando el "calendar global" del negocio; este modelo
// agrega calendarios personales por cada admin que conecte su Gmail.
model AdminGoogleCalendar {
  id           String    @id @default(cuid())
  adminId      String    @unique
  admin        Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  email        String    // email Gmail conectado (puede diferir del email del admin)
  refreshToken String
  accessToken  String?
  tokenExpiry  DateTime?
  calendarId   String    @default("primary")
  isConnected  Boolean   @default(true)
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_google_calendars")
}

// Audit log de cambios en cards. Sirve para rastrear quién editó qué
// campo y cuándo. Útil para diagnosticar incidentes como el bug del
// phone corrupto (4 jun 2026: alguien cambió el phone de Angeles Mendez
// silenciosamente y todos los mensajes futuros le llegaron a otra persona).
model CardEdit {
  id        String   @id @default(cuid())
  cardId    String
  field     String   // 'phone' | 'name' | 'email' | 'birthday' | 'notes'
  oldValue  String?
  newValue  String?
  changedBy String?  // admin uid o email
  changedAt DateTime @default(now())

  @@index([cardId, changedAt])
  @@index([changedAt])
  @@map("card_edits")
}

// Reset de contraseñas de admin
model AdminReset {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("admin_resets")
}

// Dispositivos Apple Wallet
model AppleDevice {
  id           String   @id @default(cuid())
  deviceId     String
  pushToken    String
  passTypeId   String
  serialNumber String
  createdAt    DateTime @default(now())

  @@unique([deviceId, passTypeId, serialNumber])
  @@map("apple_devices")
}

// Actualizaciones Apple Wallet
model AppleUpdate {
  id           String   @id @default(cuid())
  serialNumber String
  updatedAt    DateTime @default(now())

  @@map("apple_updates")
}

// Dispositivos Google Wallet
model GoogleDevice {
  id        String   @id @default(cuid())
  cardId    String
  objectId  String
  createdAt DateTime @default(now())

  @@map("google_devices")
}

// ========== EXPEDIENTES DE CLIENTAS ==========

// Expediente principal de la clienta
model ClientRecord {
  id     String @id @default(cuid())
  cardId String @unique

  // Datos personales adicionales
  age            Int?
  skinType       String? // normal, grasa, seca, mixta, sensible
  allergies      String? // Alergias conocidas
  medicalHistory String? // Antecedentes médicos relevantes
  objectives     String? // Objetivos del tratamiento
  observations   String? // Observaciones generales

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  sessions TreatmentSession[]
  photos   ClientPhoto[]
  fichaLinkSentAt DateTime?

  intake        IntakeForm?
  consents      ConsentDoc[]
  diagnoses     FacialDiagnosis[]
  laserSessions LaserSessionLog[]
  documents     ClientDocument[]

  @@map("client_records")
}

// Sesiones de tratamiento
model TreatmentSession {
  id       String       @id @default(cuid())
  recordId String
  record   ClientRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // Datos de la sesión
  date          DateTime @default(now())
  treatmentType String // facial, corporal, depilación, etc.
  serviceName   String?
  staffName     String?

  // Parámetros del aparato
  deviceName     String? // Nombre del aparato usado
  deviceSettings Json? // Configuración: potencia, frecuencia, tiempo, etc.

  // Zonas tratadas
  treatedAreas String? // Zonas del cuerpo/cara tratadas

  // Productos utilizados
  productsUsed String?

  // Observaciones de la sesión
  observations    String?
  results         String?
  recommendations String? // Recomendaciones para próxima sesión

  // Fotos de la sesión
  photos ClientPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("treatment_sessions")
}

// Fotos del expediente
model ClientPhoto {
  id       String       @id @default(cuid())
  recordId String
  record   ClientRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  sessionId String?
  session   TreatmentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Datos de la foto
  url         String // URL de la imagen
  publicId    String? // ID para Cloudinary/storage
  type        String  @default("progress") // before, after, progress
  category    String? // facial, corporal, etc.
  area        String? // Zona específica
  description String?

  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@map("client_photos")
}

// Ficha Clínica digital (la llena la clienta desde su celular)
model IntakeForm {
  id       String       @id @default(cuid())
  recordId String       @unique
  record   ClientRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  status String @default("draft") // draft | signed

  // Datos personales (nombre/teléfono se precargan de Card pero son editables)
  fullName       String?
  birthDate      String?
  age            Int?
  phone          String?
  profession     String?
  address        String?
  socialMedia    String?
  referralSource String? // "Medio por el cual se enteró de nosotros"

  // Datos de interés: { cicloMenstrual:'R'|'IR'|'NP', embarazo:{value,detail}, lactancia:{...},
  //  alergias:{...}, vitaminas:{...}, medicamentos:{...}, implantes:{...},
  //  anticonceptivos:{...}, intervenciones:{...}, protectorSolar:{...} }
  interestData Json?

  // Condiciones, padecimientos y enfermedades de la piel
  skinCondition      String? // "Condición de la piel que se busca mejorar"
  conditionSince     String?
  previousTreatments String?
  treatmentReactions String?

  // Cuestionarios por condición: { acne:{...}, cicatrices:{...}, pigmentaciones:{...},
  //  envejecimiento:{...}, ojerasInflamadas:{...}, ojerasPigmentadas:{...}, pielSensible:{...} }
  questionnaires Json?

  routineDay   Json? // array de strings
  routineNight Json?

  photoConsent    Boolean? // SÍ/NO AUTORIZO fotografías
  signatureClient String?  // dataURL PNG
  signatureStaff  String?
  signedAt        DateTime?

  pdfDriveFileId     String?
  pdfWebViewLink     String?
  driveUploadPending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("intake_forms")
}

// Consentimientos firmados (hoy solo depilación láser diodo)
model ConsentDoc {
  id       String       @id @default(cuid())
  recordId String
  record   ClientRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  type        String @default("laser-diodo")
  textVersion String @default("2026-07")
  status      String @default("pending") // pending | signed

  signatureClient String?
  signedAt        DateTime?

  pdfDriveFileId     String?
  pdfWebViewLink     String?
  driveUploadPending Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consent_docs")
}

// Diagnóstico facial (lo llena la cosmetóloga en el admin)
model FacialDiagnosis {
  id       String       @id @default(cuid())
  recordId String
  record   ClientRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  skinType   String?
  alteration String? // Alteración y/o condición de piel
  causes     String?
  cosmeticTx String? // TX cosmético
  prognosis  String?
  cost       String?
  staffName  String?

  pdfDriveFileId String?
  pdfWebViewLink String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("facial_diagnoses")
}

// Ficha de seguimiento fotodepilación láser (una fila por sesión)
model LaserSessionLog {
  id       String       @id @default(cuid())
  recordId String
  record   ClientRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  date           DateTime @default(now())
  staffName      String?
  zone           String?
  frequency      String?
  fluence        String?
  laserIntensity String?
  observations   String?

  signatureClient String?   // firma de la clienta (dataURL PNG) para esta sesión
  signedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("laser_session_logs")
}

// Archivos del expediente en Google Drive (escaneados importados y PDFs generados)
model ClientDocument {
  id       String       @id @default(cuid())
  recordId String
  record   ClientRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  name        String
  mimeType    String?
  driveFileId String
  webViewLink String?
  source      String @default("scan-import") // scan-import | generated
  sizeBytes   Int?

  uploadedAt DateTime @default(now())

  @@map("client_documents")
}

// Mensajes WhatsApp (historial entrante y saliente)
model WhatsappMessage {
  id        String   @id @default(cuid())
  phone     String
  name      String?
  body      String
  direction String // 'in' | 'out'
  timestamp DateTime @default(now())
  read      Boolean  @default(false)
  messageId String?
  createdAt DateTime @default(now())

  @@map("whatsapp_messages")
}

// Mapeo poll_message_id → appointment_id para respuestas de polls de Evolution API
model PendingPoll {
  id            String   @id // = pollMessageId devuelto por Evolution API
  appointmentId String
  phone         String
  expiresAt     DateTime
  options       String? // JSON array de opciones del poll
  createdAt     DateTime @default(now())

  @@map("pending_polls")
}

// Historial de canjes de Gift Cards
model GiftCardRedeem {
  id         String   @id @default(cuid())
  code       String
  service    String?
  clientName String?  @map("client_name")
  expiryDate String?  @map("expiry_date")
  redeemedAt DateTime @default(now()) @map("redeemed_at")
  createdAt  DateTime @default(now())

  @@map("gift_card_redeems")
}

// Configuración del negocio (singleton, id=1)
model BusinessConfig {
  id               Int      @id @default(1)
  businessName     String   @default("Venus Cosmetología") @map("business_name")
  whatsappBusiness String?  @map("whatsapp_business")
  address          String?
  mapsUrl          String?  @map("maps_url")
  openTime         String   @default("09:00") @map("open_time")
  closeTime        String   @default("19:00") @map("close_time")
  workDays         Int[]    @default([1, 2, 3, 4, 5, 6]) @map("work_days")
  interval         Int      @default(60) // minutos entre slots
  minHoursAdvance  Int      @default(4) @map("min_hours_advance") // horas mínimas de anticipación
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("business_config")
}

// Bloqueos de horario (días específicos o recurrentes)
model BlockedSlot {
  id        String   @id @default(cuid())
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  date      String? // "YYYY-MM-DD" (Fecha específica, opcional)
  dayOfWeek Int? // 0-6 (Día recurrente, 0=Dom, opcional)
  reason    String? // Motivo del bloqueo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blocked_slots")
}

// ===== GOOGLE CALENDAR OAUTH2 =====

// Almacena los tokens OAuth2 de Google Calendar (singleton, id=1)
model GoogleCalendarConfig {
  id           Int       @id @default(autoincrement())
  refreshToken String?   @map("refresh_token")
  accessToken  String?   @map("access_token")
  tokenExpiry  DateTime? @map("token_expiry")
  calendarId   String    @default("primary") @map("calendar_id")
  isConnected  Boolean   @default(false) @map("is_connected")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("google_calendar_config")
}

// Mapeo entre citas del sistema y eventos de Google Calendar
model GoogleCalendarMapping {
  id            Int      @id @default(autoincrement())
  appointmentId String   @map("appointment_id")
  googleEventId String   @unique @map("google_event_id")
  syncStatus    String   @default("synced") @map("sync_status") // synced, pending, failed
  errorMessage  String?  @map("error_message")
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, googleEventId])
  @@map("google_calendar_mapping")
}

// ===== VENUS THE COFFEE BAR - POS =====

model CoffeeProduct {
  id        String                 @id @default(cuid())
  name      String
  category  String // cafe_caliente, cafe_frio, panaderia, extras
  price     Decimal                @db.Decimal(10, 2)
  taxRate   Decimal                @default(0.16) @map("tax_rate") @db.Decimal(5, 4)
  isActive  Boolean                @default(true) @map("is_active")
  sortOrder Int                    @default(0) @map("sort_order")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  variants  CoffeeProductVariant[]
  saleItems CoffeeSaleItem[]

  @@map("coffee_products")
}

model CoffeeProductVariant {
  id        String        @id @default(cuid())
  productId String        @map("product_id")
  name      String // "Grande", "Leche de almendra"
  type      String // "size", "extra"
  priceAdj  Decimal       @default(0) @map("price_adj") @db.Decimal(10, 2)
  isActive  Boolean       @default(true) @map("is_active")
  product   CoffeeProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("coffee_product_variants")
}

model CoffeeSale {
  id            String             @id @default(cuid())
  folio         String             @unique
  cashSessionId String?            @map("cash_session_id")
  cashierName   String             @map("cashier_name")
  subtotal      Decimal            @db.Decimal(10, 2)
  tax           Decimal            @db.Decimal(10, 2)
  discount      Decimal            @default(0) @db.Decimal(10, 2)
  total         Decimal            @db.Decimal(10, 2)
  paymentMethod String             @map("payment_method")
  amountPaid    Decimal?           @map("amount_paid") @db.Decimal(10, 2)
  change        Decimal?           @db.Decimal(10, 2)
  status        String             @default("completed")
  cancelReason  String?            @map("cancel_reason")
  cancelledBy   String?            @map("cancelled_by")
  createdAt     DateTime           @default(now()) @map("created_at")
  items         CoffeeSaleItem[]
  cashSession   CoffeeCashSession? @relation(fields: [cashSessionId], references: [id])

  @@map("coffee_sales")
}

model CoffeeSaleItem {
  id          String        @id @default(cuid())
  saleId      String        @map("sale_id")
  productId   String        @map("product_id")
  productName String        @map("product_name")
  qty         Int           @default(1)
  unitPrice   Decimal       @map("unit_price") @db.Decimal(10, 2)
  discount    Decimal       @default(0) @db.Decimal(10, 2)
  notes       String?
  variants    String? // JSON string de variantes seleccionadas
  sale        CoffeeSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     CoffeeProduct @relation(fields: [productId], references: [id])

  @@map("coffee_sale_items")
}

model CoffeeCashSession {
  id            String               @id @default(cuid())
  openedBy      String               @map("opened_by")
  openedAt      DateTime             @default(now()) @map("opened_at")
  openingAmount Decimal              @map("opening_amount") @db.Decimal(10, 2)
  closedBy      String?              @map("closed_by")
  closedAt      DateTime?            @map("closed_at")
  expectedCash  Decimal?             @map("expected_cash") @db.Decimal(10, 2)
  actualCash    Decimal?             @map("actual_cash") @db.Decimal(10, 2)
  difference    Decimal?             @db.Decimal(10, 2)
  totalSales    Decimal?             @map("total_sales") @db.Decimal(10, 2)
  status        String               @default("open")
  notes         String?
  sales         CoffeeSale[]
  movements     CoffeeCashMovement[]

  @@map("coffee_cash_sessions")
}

model CoffeeCashMovement {
  id            String            @id @default(cuid())
  cashSessionId String            @map("cash_session_id")
  type          String // "income", "withdrawal"
  amount        Decimal           @db.Decimal(10, 2)
  reason        String
  createdBy     String            @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")
  cashSession   CoffeeCashSession @relation(fields: [cashSessionId], references: [id])

  @@map("coffee_cash_movements")
}

// Evaluaciones post-cita
model Review {
  id            String    @id @default(cuid())
  appointmentId String    @unique @map("appointment_id")
  clientName    String    @map("client_name")
  clientPhone   String    @map("client_phone")
  serviceName   String    @map("service_name")
  stars         Int // 1-5
  liked         String? // Lo que más le gustó
  improve       String? // Lo que mejoraría
  comment       String? // Comentario adicional
  replied       Boolean   @default(false)
  reply         String?
  repliedAt     DateTime? @map("replied_at")
  sentAt        DateTime? @map("sent_at") // Cuándo se envió el link
  answeredAt    DateTime? @map("answered_at") // Cuándo respondió
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("reviews")
}

// ===== VENUS SKIN - Análisis de piel (integración Yiyuan Analyzer) =====

model SkinAnalysis {
  id          String  @id @default(cuid())
  cardId      String? @map("card_id")
  clientPhone String? @map("client_phone")
  clientName  String  @map("client_name")

  // IDs del sistema Yiyuan
  yiyuanShareId    String  @unique @map("yiyuan_share_id")
  yiyuanAnalysisId BigInt? @map("yiyuan_analysis_id")

  analyzedAt DateTime @map("analyzed_at")
  locale     String?  @default("es-419")

  // Datos biográficos al momento del análisis
  ageReal       Int?    @map("age_real")
  ageBiological Int?    @map("age_biological")
  sex           String? // 'F' | 'M'

  // Clasificación de piel (traducida al español)
  skinType  String?  @map("skin_type") // 'Grasa' | 'Seca' | 'Mixta' | 'Normal'
  skinColor String?  @map("skin_color") // fototipo en texto
  ita       Decimal? @db.Decimal(6, 2)

  // Scores globales (0-100)
  overallScore    Int? @map("overall_score")
  appearanceScore Int? @map("appearance_score")

  // Métricas estéticas
  faceShape      String?  @map("face_shape")
  goldenTriangle Decimal? @map("golden_triangle") @db.Decimal(6, 4)

  // Narrativa generada con IA (Fase 3)
  aiSummaryEs          String? @map("ai_summary_es")
  aiRecommendations    Json?   @map("ai_recommendations")
  treatmentSuggestions Json?   @map("treatment_suggestions")

  // JSON crudo de Yiyuan (nunca se pierde información)
  rawResponse Json @map("raw_response")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card   Card?               @relation(fields: [cardId], references: [id], onDelete: SetNull)
  scores SkinAnalysisScore[]
  images SkinAnalysisImage[]

  @@index([cardId, analyzedAt])
  @@index([clientPhone])
  @@map("skin_analyses")
}

model SkinAnalysisScore {
  id         String @id @default(cuid())
  analysisId String @map("analysis_id")

  metric  String // 'acne'|'blackhead'|'pore'|'spot'|'pigment'|'uv_spot'|'pockmark'|'wrinkle'|'texture'|'collagen'|'ext_water'|'sensitive'|'dark_circle'
  labelEs String @map("label_es")

  score    Decimal @db.Decimal(6, 2)
  level    Int?
  count    Int?
  severity String // 'excellent'|'good'|'moderate'|'concern'|'critical'

  imageUrl String? @map("image_url")

  createdAt DateTime     @default(now()) @map("created_at")
  analysis  SkinAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([metric])
  @@map("skin_analysis_scores")
}

model SkinAnalysisImage {
  id         String @id @default(cuid())
  analysisId String @map("analysis_id")

  imageType String @map("image_type") // 'normal'|'positive'|'negative'|'uv'|'woods'|'blue'|'brown'|'red'|'aging_simu'|'face_atriums'|'face_eyes'
  labelEs   String @map("label_es")

  originalUrl String  @map("original_url") // URL pública en zm.yiyuan.ai
  storagePath String? @map("storage_path") // path local si descargamos (Fase futura)

  createdAt DateTime     @default(now()) @map("created_at")
  analysis  SkinAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("skin_analysis_images")
}

// ========== MARKETING ==========

// Leads / Mini-CRM para la persona de marketing
model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  origin        String   @default("otro") // facebook-ads | instagram | referido | whatsapp | calle | otro
  notes         String?
  status        String   @default("nuevo") // nuevo | contactado | agendado | convertido | perdido
  score         Int      @default(0) // 0-100, computado en read
  marketerId    String   @map("marketer_id")
  marketer      Admin    @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  appointmentId String?  @unique @map("appointment_id") // cita resultante cuando se convierte
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  contactedAt   DateTime? @map("contacted_at")
  convertedAt   DateTime? @map("converted_at")

  @@index([marketerId])
  @@index([status])
  @@index([score])
  @@map("leads")
}

// Comisiones por cita agendada (1 cita = 1 comisión)
model Commission {
  id            String      @id @default(cuid())
  marketerId    String      @map("marketer_id")
  marketer      Admin       @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  appointmentId String      @unique @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  amount        Float       // monto fijo configurado al momento de agendar (snapshot)
  status        String      @default("pendiente") // pendiente | pagada | cancelada
  paidAt        DateTime?   @map("paid_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([marketerId])
  @@index([status])
  @@map("commissions")
}

// Programa de referidos
model Referral {
  id              String   @id @default(cuid())
  referrerCardId  String   @map("referrer_card_id")
  referrerCard    Card     @relation("ReferralReferrer", fields: [referrerCardId], references: [id], onDelete: Cascade)
  inviteeCardId   String   @map("invitee_card_id")
  inviteeCard     Card     @relation("ReferralInvitee", fields: [inviteeCardId], references: [id], onDelete: Cascade)
  inviteePhone    String   @map("invitee_phone")
  status          String   @default("pendiente") // pendiente | completada | pagada
  completedAt     DateTime? @map("completed_at")
  awardedAt       DateTime? @map("awarded_at") // cuándo se otorgó el sello al referrer
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([inviteeCardId]) // 1 referido = 1 referral
  @@index([referrerCardId])
  @@map("referrals")
}

// Retos de sellos (ej. 3 visitas en 30 días = sello extra)
model Challenge {
  id               String   @id @default(cuid())
  cardId           String   @map("card_id")
  card             Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind             String   @default("tres_visitas_30") // tres_visitas_30 | doble_sello_dia | custom
  startedAt        DateTime @default(now()) @map("started_at")
  targetVisits     Int      @default(3) @map("target_visits")
  windowDays       Int      @default(30) @map("window_days")
  visitsCompleted  Int      @default(0) @map("visits_completed")
  completedAt      DateTime? @map("completed_at")
  bonusStamps      Int      @default(1) @map("bonus_stamps")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([cardId])
  @@index([kind])
  @@map("challenges")
}

// Ventanas promocionales (ej. doble sello los martes, winback 10% off)
model Promotion {
  id        String   @id @default(cuid())
  type      String   @default("doble_sello") // doble_sello | bonus_stamp | winback_discount
  name      String
  active    Boolean  @default(true)
  config    Json     // { weekday:2, category:'facial', discountPct:10, ... }
  startsAt  DateTime @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([active])
  @@map("promotions")
}

// Atribución multi-touch: cada contacto de un cliente con el negocio
model Touchpoint {
  id        String   @id @default(cuid())
  cardId    String?  @map("card_id")
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  channel   String   // instagram | facebook-ads | referral | whatsapp | online | direct
  campaign  String?
  utm       Json?
  timestamp DateTime @default(now())

  // Relación opcional con la cita que originó este touchpoint
  appointmentId String? @unique @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([channel])
  @@map("touchpoints")
}

// ── Paquetes de sesiones (láser, faciales, corporales) ──────────────────
// El catálogo ya vendía "paquetes" como texto en la descripción del
// servicio ("Paquete 10 sesiones $3000") sin ningún control de saldo: el
// conteo vivía en la cabeza de la dueña. Fuente #1 de conflictos.

model SessionPackage {
  id            String   @id @default(cuid())
  name          String // "Drenaje linfático · 10 sesiones"
  serviceName   String? // servicio al que aplica (informativo)
  sessionsTotal Int
  price         Decimal  @db.Decimal(10, 2)
  validityDays  Int? // vigencia desde la compra; null = no vence
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases ClientPackage[]

  @@map("session_packages")
}

model ClientPackage {
  id            String         @id @default(cuid())
  cardId        String // clienta (Card.id)
  packageId     String
  package       SessionPackage @relation(fields: [packageId], references: [id])
  sessionsTotal Int // copiado al comprar: el catálogo puede cambiar después
  sessionsUsed  Int            @default(0)
  pricePaid     Decimal        @db.Decimal(10, 2)
  paymentMethod String?
  purchasedAt   DateTime       @default(now())
  expiresAt     DateTime?
  status        String         @default("active") // active | exhausted | expired | cancelled

  uses PackageUse[]

  @@index([cardId])
  @@map("client_packages")
}

model PackageUse {
  id              String        @id @default(cuid())
  clientPackageId String
  clientPackage   ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)
  appointmentId   String?
  usedAt          DateTime      @default(now())
  by              String? // quién descontó (admin/recepcion)
  note            String?

  @@map("package_uses")
}

// ── Checklist de marketing (tablas creadas por SQL crudo del módulo de
// marketing; se declaran aquí mapeadas EXACTAS para que `db push` no
// intente tirarlas — deriva detectada el 20-ago-2026 con 24 filas vivas).

model MarketingTask {
  id        Int       @id @default(autoincrement())
  section   String
  title     String
  detail    String?
  frequency String    @default("once")
  dueDate   DateTime? @map("due_date") @db.Date
  sort      Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  logs MarketingTaskLog[]

  @@map("marketing_tasks")
}

model MarketingTaskLog {
  id        Int           @id @default(autoincrement())
  taskId    Int           @map("task_id")
  task      MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneDate  DateTime      @map("done_date") @db.Date
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  @@unique([taskId, doneDate])
  @@map("marketing_task_logs")
}
